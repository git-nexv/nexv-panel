#!/usr/bin/env bash
# nexv - management script for NexV Panel
set -uo pipefail

INSTALL_DIR="/opt/nexv-panel"
DATA_DIR="/etc/nexv/data"
SERVICE="nexv"
BRANCH="${NEXV_BRANCH:-main}"

GREEN=$'\e[32m'; RED=$'\e[31m'; YELLOW=$'\e[33m'; CYAN=$'\e[36m'; BOLD=$'\e[1m'; RESET=$'\e[0m'

# Installs before v2 lived in /opt/nexv-vpanel; keep working if one is still there.
[[ -d $INSTALL_DIR || ! -d /opt/nexv-vpanel ]] || INSTALL_DIR="/opt/nexv-vpanel"

need_root() { [[ $EUID -eq 0 ]] || { echo "${RED}This command needs root. Run it with sudo.${RESET}"; exit 1; }; }
ok()   { echo "${GREEN}[+]${RESET} $*"; }
err()  { echo "${RED}[x]${RESET} $*"; }
warn() { echo "${YELLOW}[!]${RESET} $*"; }


# Is anything listening on this TCP port? Tries whichever tool the box has.
is_port_in_use() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltn 2>/dev/null | awk -v p=":${port}$" '$4 ~ p { found = 1 } END { exit !found }' && return 0
    return 1
  fi
  if command -v netstat >/dev/null 2>&1; then
    netstat -lnt 2>/dev/null | awk -v p=":${port}$" '$4 ~ p { found = 1 } END { exit !found }' && return 0
    return 1
  fi
  if command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"${port}" -sTCP:LISTEN >/dev/null 2>&1 && return 0
  fi
  return 1
}

# Which process holds it, when we can tell.
port_owner() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -ltnp 2>/dev/null | awk -v p=":${port}$" '$4 ~ p { print $NF; exit }'
  elif command -v lsof >/dev/null 2>&1; then
    lsof -nP -iTCP:"${port}" -sTCP:LISTEN -F c 2>/dev/null | sed -n 's/^c//p' | head -1
  fi
}

firewall_kind() {
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
    echo ufw
  elif command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active --quiet firewalld 2>/dev/null; then
    echo firewalld
  else
    echo none
  fi
}

# Open one port in whichever firewall is running. A no-op when none is active,
# which is the common case on a fresh VPS.
allow_port() {
  local port="$1"
  case "$(firewall_kind)" in
    ufw)       ufw allow "$port"/tcp >/dev/null 2>&1 && ok "Opened port $port in ufw" ;;
    firewalld) firewall-cmd --permanent --add-port="$port"/tcp >/dev/null 2>&1 &&
               firewall-cmd --reload >/dev/null 2>&1 && ok "Opened port $port in firewalld" ;;
    *)         : ;;
  esac
}

panel_port() {
  DATA_DIR="$DATA_DIR" node -e '
    try {
      const db = require(process.env.DATA_DIR + "/db.json");
      process.stdout.write(String((db.settings && db.settings.panelPort) || 2087));
    } catch (e) { process.stdout.write("2087"); }
  ' 2>/dev/null || echo 2087
}

confirm() {
  # the panel runs the repairs itself, with nobody there to answer
  [[ ${NEXV_ASSUME_YES:-0} == 1 ]] && return 0
  local answer
  read -rp "$1 [y/N]: " answer
  [[ ${answer,,} == y || ${answer,,} == yes ]]
}

pause() {
  echo
  read -rp "Press Enter to return to the menu..." _
}

# ----------------------------------------------------------------- actions --

act_status() {
  systemctl status "$SERVICE" --no-pager -l || true
  echo
  systemctl status xray --no-pager -l || true
}

act_service() {
  need_root
  systemctl "$1" "$SERVICE" && ok "Panel: $1 done" || err "Panel: $1 failed"
}

act_logs()      { journalctl -u "$SERVICE" -n "${1:-100}" -f --no-pager; }
act_xray_logs() { journalctl -u xray -n "${1:-100}" -f --no-pager; }

# A checksum of what is actually installed, which is not the same as a
# checksum of the lockfile: every release bumps the panel's own version and
# that number appears in the lockfile too. Hashing the file as it sits would
# therefore differ on every single update and the skip below would never once
# fire. So the panel's own version is taken out first and the dependencies -
# and only those - are what is compared.
lock_sum() {
  local file="$INSTALL_DIR/package-lock.json"
  [[ -f $file ]] || file="$INSTALL_DIR/package.json"
  [[ -f $file ]] || { echo none; return; }
  LOCK_FILE="$file" node -e '
    const fs = require("fs");
    const crypto = require("crypto");
    try {
      const lock = JSON.parse(fs.readFileSync(process.env.LOCK_FILE, "utf8"));
      delete lock.version;
      if (lock.packages && lock.packages[""]) delete lock.packages[""].version;
      if (lock.dependencies) delete lock.dependencies.version;
      process.stdout.write(crypto.createHash("sha256").update(JSON.stringify(lock)).digest("hex"));
    } catch (_) {
      // unreadable or not JSON: say so distinctly, which installs rather than skips
      process.stdout.write("unknown-" + Date.now());
    }
  ' 2>/dev/null || echo "unknown-$RANDOM"
}

act_update() {
  need_root
  local before after rc

  # Every step is announced, because the panel shows this output while it waits
  # and a silent five minutes is indistinguishable from a hang.
  echo "Fetching the latest version..."
  before="$(lock_sum)"

  # A filtered link does not refuse the connection, it stalls on it. Without a
  # limit git waits forever, the panel waits on git, and the person watching is
  # told nothing at all. Give up after ten minutes, or sooner if the transfer
  # drops under 1 KB/s for a minute, and say which of the two it was.
  timeout 600 git -C "$INSTALL_DIR" \
    -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=60 \
    fetch --depth 1 origin "$BRANCH" -q
  rc=$?
  if [[ $rc -ne 0 ]]; then
    if [[ $rc -eq 124 ]]; then
      err "Could not reach the repository: it did not answer within ten minutes."
    else
      err "Could not reach the repository (git exited $rc)."
    fi
    echo "UPDATE-FAILED"
    return 1
  fi

  git -C "$INSTALL_DIR" reset --hard "origin/$BRANCH" -q || { err "Could not apply the new files"; echo "UPDATE-FAILED"; return 1; }
  after="$(lock_sum)"

  # npm install is nearly all of the time an update takes, and nearly every
  # update changes no dependency at all. Run it when the lockfile moved - or
  # when there is nothing installed yet - and skip it otherwise.
  if [[ $before != "$after" || ! -d $INSTALL_DIR/node_modules ]]; then
    echo "Dependencies changed - installing..."
    ( cd "$INSTALL_DIR" && timeout 900 npm install --omit=dev --no-audit --no-fund \
        --prefer-offline --no-progress --fetch-timeout=120000 --fetch-retries=2 --loglevel=error )
    rc=$?
    if [[ $rc -ne 0 ]]; then
      [[ $rc -eq 124 ]] && err "npm install gave up after fifteen minutes - the registry is not answering." \
                       || err "npm install failed (exit $rc)."
      echo "UPDATE-FAILED"
      return 1
    fi
  else
    echo "Dependencies unchanged - skipping npm install."
  fi

  install -m 755 "$INSTALL_DIR/scripts/nexv" /usr/local/bin/nexv
  echo "Restarting the panel..."
  systemctl restart "$SERVICE"
  ok "Panel updated"
  echo "UPDATE-DONE"
  # a fresh install generates a secret web path; never let the admin lose it
  sleep 2
  act_url
}

act_backup() {
  need_root
  local out="${1:-/root/nexv-backup-$(date +%Y%m%d-%H%M%S).json}"
  cp "$DATA_DIR/db.json" "$out" && chmod 600 "$out" && ok "Backup saved: $out"
}

act_restore() {
  need_root
  local file="${1:-}"
  [[ -f $file ]] || { err "Give the path to a backup file: nexv restore <file>"; return 1; }
  cp "$DATA_DIR/db.json" "$DATA_DIR/db.json.before-restore" 2>/dev/null || true
  cp "$file" "$DATA_DIR/db.json"
  chmod 600 "$DATA_DIR/db.json"
  systemctl restart "$SERVICE"
  ok "Restored from $file"
}

act_url() {
  need_root
  NEW_PATH="${1:-}" DATA_DIR="$DATA_DIR" node -e '
    const fs = require("fs"), path = require("path"), crypto = require("crypto");
    const file = path.join(process.env.DATA_DIR, "db.json");
    const db = JSON.parse(fs.readFileSync(file, "utf8"));
    db.settings = db.settings || {};
    const arg = (process.env.NEW_PATH || "").trim();
    if (arg === "random") {
      db.settings.webBasePath = "/" + crypto.randomBytes(9).toString("base64url");
    } else if (arg === "none") {
      db.settings.webBasePath = "";
    } else if (arg) {
      const clean = arg.replace(/^\/+|\/+$/g, "");
      if (!/^[A-Za-z0-9_\-\/]{1,64}$/.test(clean)) {
        console.error("invalid path: use letters, digits, - _ / only");
        process.exit(1);
      }
      db.settings.webBasePath = "/" + clean;
    }
    if (arg) fs.writeFileSync(file, JSON.stringify(db, null, 2), { mode: 0o600 });
    const port = db.settings.panelPort || 2087;
    const host = db.settings.domain || db.settings.serverIP || "SERVER-IP";
    const cert = db.settings.panelCertFile || db.settings.certFile || "";
    const key = db.settings.panelKeyFile || db.settings.keyFile || "";
    const secure = !!(cert && key && fs.existsSync(cert) && fs.existsSync(key));
    console.log("");
    console.log("  Panel URL:  " + (secure ? "https" : "http") + "://" + host + ":" + port + (db.settings.webBasePath || "") + "/");
    if (!secure) console.log("  TLS is off. Enable it with: nexv cert <domain>");
    console.log("");
  ' || return 1
  [[ -n ${1:-} ]] && { systemctl restart "$SERVICE"; ok "New path applied"; }
  return 0
}

act_port() {
  need_root
  local port="${1:-}"
  [[ $port =~ ^[0-9]+$ ]] && (( port >= 1 && port <= 65535 )) || { err "Give a port number between 1 and 65535"; return 1; }
  if [[ $port != "$(panel_port)" ]] && is_port_in_use "$port"; then
    err "Port $port is already used by: $(port_owner "$port" || echo 'another process')"
    return 1
  fi
  PORT="$port" DATA_DIR="$DATA_DIR" node -e '
    const fs = require("fs"), path = require("path");
    const file = path.join(process.env.DATA_DIR, "db.json");
    const db = JSON.parse(fs.readFileSync(file, "utf8"));
    db.settings = db.settings || {};
    db.settings.panelPort = Number(process.env.PORT);
    fs.writeFileSync(file, JSON.stringify(db, null, 2), { mode: 0o600 });
  ' || return 1
  allow_port "$port"
  systemctl restart "$SERVICE"
  ok "Panel port changed to $port"
  act_url
}

act_settings() {
  need_root
  DATA_DIR="$DATA_DIR" node -e '
    const fs = require("fs"), path = require("path");
    const db = JSON.parse(fs.readFileSync(path.join(process.env.DATA_DIR, "db.json"), "utf8"));
    const s = db.settings || {};
    const row = (k, v) => console.log("  " + k.padEnd(22) + (v === "" || v === undefined ? "-" : v));
    console.log("");
    row("Panel port", s.panelPort || 2087);
    row("Web base path", s.webBasePath || "(none)");
    row("Domain", s.domain);
    row("Subscription port", s.subPort);
    row("Subscription path", s.subPath);
    row("TLS certificate", s.certFile);
    row("TLS private key", s.keyFile);
    const cert = s.panelCertFile || s.certFile || "";
    const key = s.panelKeyFile || s.keyFile || "";
    row("Panel HTTPS", (cert && key && fs.existsSync(cert) && fs.existsSync(key)) ? "on" : "off");
    row("Xray log level", s.xrayLogLevel || "warning");
    row("Default outbound", s.defaultOutbound || "direct");
    row("Domain strategy", s.domainStrategy || "AsIs");
    row("Block BitTorrent", s.blockTorrent ? "yes" : "no");
    row("Admins", (db.users || []).map((u) => u.username).join(", "));
    row("Inbounds", (db.inbounds || []).length);
    row("Clients", (db.clients || []).length);
    row("Outbounds", (db.outbounds || []).length);
    row("Routing rules", (db.routing || []).length);
    console.log("");
  '
}

act_cert() {
  need_root
  local domain="${1:-}"
  [[ -n $domain ]] || { err "Give a domain: nexv cert example.com"; return 1; }
  if ! command -v certbot >/dev/null; then
    err "certbot is not installed"
    echo "  Install it with: apt-get install -y certbot   (or: dnf install -y certbot)"
    return 1
  fi

  # port 80 must be free for the standalone challenge
  systemctl stop nginx 2>/dev/null || true
  certbot certonly --standalone --non-interactive --agree-tos \
    --register-unsafely-without-email -d "$domain" || { err "Certificate request failed"; return 1; }

  local cert="/etc/letsencrypt/live/$domain/fullchain.pem"
  local key="/etc/letsencrypt/live/$domain/privkey.pem"
  [[ -f $cert && -f $key ]] || { err "certbot reported success but $cert is missing"; return 1; }
  ok "Certificate ready:"
  echo "  $cert"
  echo "  $key"

  # renew unattended, and restart both services so they pick up the new files
  cat > /etc/cron.d/nexv-cert-renew <<EOF
0 3 * * * root certbot renew --quiet --deploy-hook "systemctl restart xray nexv"
EOF
  ok "Automatic renewal installed (daily check at 03:00)"

  # wire the paths into the panel so it actually serves HTTPS
  DOMAIN="$domain" CERT="$cert" KEY="$key" DATA_DIR="$DATA_DIR" node -e '
    const fs = require("fs"), path = require("path");
    const file = path.join(process.env.DATA_DIR, "db.json");
    const db = JSON.parse(fs.readFileSync(file, "utf8"));
    db.settings = db.settings || {};
    db.settings.domain = db.settings.domain || process.env.DOMAIN;
    db.settings.certFile = process.env.CERT;
    db.settings.keyFile = process.env.KEY;
    db.settings.panelCertFile = process.env.CERT;
    db.settings.panelKeyFile = process.env.KEY;
    if (Number(db.settings.panelPort) === 80) console.log("panel-on-80");
    fs.writeFileSync(file, JSON.stringify(db, null, 2), { mode: 0o600 });
  ' > /tmp/nexv-cert-result.$$ 2>&1 || {
    err "Could not write the certificate paths into the panel settings"
    cat /tmp/nexv-cert-result.$$ >&2
    rm -f /tmp/nexv-cert-result.$$
    return 1
  }
  if grep -q panel-on-80 /tmp/nexv-cert-result.$$; then
    echo
    warn "The panel is on port 80, and it now speaks TLS there."
    echo "  Plain http:// will fail against it, and https:// goes to 443."
    echo "  Pick a port for the panel:  nexv port <number>"
  fi
  rm -f /tmp/nexv-cert-result.$$

  allow_port "$(panel_port)"

  systemctl restart "$SERVICE"
  sleep 2
  if systemctl is-active --quiet "$SERVICE"; then
    ok "Panel restarted with HTTPS enabled"
    act_url
  else
    err "The panel did not come back up. Check: nexv logs 50"
    return 1
  fi
}

act_reset_password() {
  need_root
  local newpass="${1:-}"
  if [[ -n $newpass ]]; then
    if (( ${#newpass} < 6 )); then
      err "Choose a password of at least 6 characters"
      return 1
    fi
  else
    newpass="$(openssl rand -base64 12 | tr -d '/+=' | cut -c1-14)"
  fi
  NEW_PASS="$newpass" DATA_DIR="$DATA_DIR" node -e '
    const fs = require("fs"), path = require("path");
    const bcrypt = require("'"$INSTALL_DIR"'/node_modules/bcryptjs");
    const file = path.join(process.env.DATA_DIR, "db.json");
    const db = JSON.parse(fs.readFileSync(file, "utf8"));
    if (!db.users || !db.users.length) { console.error("no admin user found"); process.exit(1); }
    db.users[0].password = bcrypt.hashSync(process.env.NEW_PASS, 10);
    db.sessions = [];
    fs.writeFileSync(file, JSON.stringify(db, null, 2), { mode: 0o600 });
  ' || return 1
  systemctl restart "$SERVICE"
  ok "New admin password: ${BOLD}$newpass${RESET}"
}

act_reset_username() {
  need_root
  local name="${1:-}"
  [[ -n $name ]] || { err "Give a username: nexv reset-username <name>"; return 1; }
  NEW_USER="$name" DATA_DIR="$DATA_DIR" node -e '
    const fs = require("fs"), path = require("path");
    const file = path.join(process.env.DATA_DIR, "db.json");
    const db = JSON.parse(fs.readFileSync(file, "utf8"));
    if (!db.users || !db.users.length) { console.error("no admin user found"); process.exit(1); }
    db.users[0].username = process.env.NEW_USER.trim();
    db.sessions = [];
    fs.writeFileSync(file, JSON.stringify(db, null, 2), { mode: 0o600 });
  ' || return 1
  systemctl restart "$SERVICE"
  ok "Admin username changed to $name"
}

act_firewall_open_panel_ports() {
  local port
  port="$(panel_port)"
  local ports=("$port" 80 443 2096)
  local kind
  kind="$(firewall_kind)"
  if [[ $kind == none ]]; then
    warn "No active firewall found; nothing to open."
    echo "  The panel ports are already reachable, unless your provider filters them."
    return 0
  fi
  for p in "${ports[@]}"; do allow_port "$p"; done
  ok "Panel ports opened in $kind: ${ports[*]}"
}

act_firewall_enable() {
  need_root
  if ! command -v ufw >/dev/null 2>&1; then
    err "ufw is not installed. Install it first (option 1)."
    return 1
  fi
  # Enabling ufw without an SSH rule locks you out of your own server.
  ufw allow ssh >/dev/null 2>&1 || ufw allow 22/tcp >/dev/null 2>&1
  ok "SSH allowed (so enabling the firewall cannot lock you out)"
  local port
  port="$(panel_port)"
  for p in "$port" 80 443 2096; do ufw allow "$p"/tcp >/dev/null 2>&1; done
  ok "Panel ports allowed: $port 80 443 2096"
  ufw --force enable && ok "Firewall enabled"
}

act_firewall_install() {
  need_root
  if command -v ufw >/dev/null 2>&1; then
    ok "ufw is already installed"
    return 0
  fi
  if command -v apt-get >/dev/null 2>&1; then
    # the same lock a fresh server holds on first boot can still be held here
    local opts=(-o DPkg::Lock::Timeout=300 -o Dpkg::Use-Pty=0)
    DEBIAN_FRONTEND=noninteractive apt-get "${opts[@]}" update -qq \
      && DEBIAN_FRONTEND=noninteractive apt-get "${opts[@]}" install -y -qq ufw >/dev/null
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y -q ufw >/dev/null
  elif command -v yum >/dev/null 2>&1; then
    yum install -y -q ufw >/dev/null
  else
    err "No supported package manager found"
    return 1
  fi
  command -v ufw >/dev/null 2>&1 && ok "ufw installed" || { err "ufw installation failed"; return 1; }
}

act_firewall_status() {
  case "$(firewall_kind)" in
    ufw)       ufw status verbose ;;
    firewalld) firewall-cmd --list-all ;;
    *)
      if command -v ufw >/dev/null 2>&1; then
        echo "ufw is installed but not active."
        ufw status
      else
        echo "No firewall is active on this server."
      fi
      ;;
  esac
}

act_firewall() {
  need_root
  while true; do
    echo
    echo "  ${BOLD}Firewall${RESET}   (currently: $(firewall_kind))"
    echo "    1. Install ufw"
    echo "    2. Enable firewall (allows SSH and the panel ports first)"
    echo "    3. Disable firewall"
    echo "    4. Open the panel ports"
    echo "    5. Open a specific port"
    echo "    6. Close a specific port"
    echo "    7. Show status and rules"
    echo "    0. Back"
    local choice port
    read -rp "  Choose an option: " choice
    echo
    case "$choice" in
      0) return 0 ;;
      1) act_firewall_install ;;
      2) act_firewall_enable ;;
      3) confirm "Disable the firewall?" && { ufw disable && ok "Firewall disabled"; } ;;
      4) act_firewall_open_panel_ports ;;
      5) read -rp "  Port to open: " port
         [[ $port =~ ^[0-9]+$ ]] && allow_port "$port" || err "Not a port number" ;;
      6) read -rp "  Port to close: " port
         if [[ $port =~ ^[0-9]+$ ]]; then
           case "$(firewall_kind)" in
             ufw)       ufw delete allow "$port"/tcp >/dev/null 2>&1 && ok "Closed $port" ;;
             firewalld) firewall-cmd --permanent --remove-port="$port"/tcp >/dev/null 2>&1 &&
                        firewall-cmd --reload >/dev/null 2>&1 && ok "Closed $port" ;;
             *)         warn "No active firewall" ;;
           esac
         else
           err "Not a port number"
         fi ;;
      7) act_firewall_status ;;
      *) err "Choose a number between 0 and 7" ;;
    esac
  done
}

act_bbr() {
  need_root
  if sysctl net.ipv4.tcp_congestion_control 2>/dev/null | grep -q bbr; then
    ok "BBR is already enabled"
    return 0
  fi
  cat >> /etc/sysctl.conf <<'EOF'
net.core.default_qdisc=fq
net.ipv4.tcp_congestion_control=bbr
EOF
  sysctl -p >/dev/null 2>&1
  sysctl net.ipv4.tcp_congestion_control | grep -q bbr && ok "BBR enabled" || err "BBR could not be enabled (kernel may be too old)"
}

act_geo() {
  need_root
  local dir="/usr/local/share/xray"
  mkdir -p "$dir"
  local base="https://github.com/Loyalsoldier/v2ray-rules-dat/releases/latest/download"
  curl -fsSL "$base/geoip.dat" -o "$dir/geoip.dat.new" && mv "$dir/geoip.dat.new" "$dir/geoip.dat" \
    && curl -fsSL "$base/geosite.dat" -o "$dir/geosite.dat.new" && mv "$dir/geosite.dat.new" "$dir/geosite.dat" \
    || { err "Could not download the geo files"; rm -f "$dir"/*.new; return 1; }
  systemctl restart xray
  ok "geoip.dat and geosite.dat updated"
}

act_doctor() {
  need_root
  echo
  echo "${BOLD}NexV Panel diagnostics${RESET}"
  echo

  printf "  %-22s %s\n" "Panel service" "$(state_of "$SERVICE")"
  printf "  %-22s %s\n" "Xray service" "$(state_of xray)"
  printf "  %-22s %s\n" "Install dir" "$INSTALL_DIR"
  printf "  %-22s %s\n" "Node" "$(node -v 2>/dev/null || echo 'missing')"

  local info
  info="$(DATA_DIR=$DATA_DIR node -e '
    const fs = require("fs");
    const db = JSON.parse(fs.readFileSync(process.env.DATA_DIR + "/db.json", "utf8"));
    const s = db.settings || {};
    const cert = s.panelCertFile || s.certFile || "";
    const key = s.panelKeyFile || s.keyFile || "";
    const secure = !!(cert && key && fs.existsSync(cert) && fs.existsSync(key));
    const port = s.panelPort || 2087;
    const host = s.domain || s.serverIP || "127.0.0.1";
    const scheme = secure ? "https" : "http";
    process.stdout.write([
      port, scheme, host, (s.webBasePath || ""), secure ? "yes" : "no", cert || "-"
    ].join("\t"));
  ' 2>/dev/null)" || { err "Cannot read $DATA_DIR/db.json"; return 1; }

  local port scheme host webpath secure cert
  IFS=$'\t' read -r port scheme host webpath secure cert <<<"$info"

  printf "  %-22s %s\n" "Panel port" "$port"
  printf "  %-22s %s\n" "HTTPS" "$secure"
  [[ $secure == yes ]] && printf "  %-22s %s\n" "Certificate" "$cert"

  # is anything actually listening on that port?
  if is_port_in_use "$port"; then
    local owner
    owner="$(port_owner "$port")"
    if [[ -n $owner && $owner != *node* && $owner != *nexv* ]]; then
      err "Port $port is held by a DIFFERENT program: $owner"
      echo "    The panel cannot be serving there. Move it with: nexv fix"
    else
      ok "A process is listening on port $port${owner:+ ($owner)}"
    fi
  elif command -v ss >/dev/null || command -v netstat >/dev/null || command -v lsof >/dev/null; then
    err "Nothing is listening on port $port"
    echo "    The panel is down or failed to bind. Check: nexv logs 50"
  else
    warn "Cannot list listening ports (install iproute2 for 'ss')"
  fi

  # a panel that cannot write its own database looks like it is ignoring every
  # change made in the web UI - the password change being the one people notice
  local svc_user probe
  svc_user="$(systemctl show "$SERVICE" -p User --value 2>/dev/null)"
  [[ -n $svc_user ]] || svc_user=root
  printf "  %-22s %s\n" "Runs as" "$svc_user"
  probe="$DATA_DIR/.write-probe"
  if runuser -u "$svc_user" -- sh -c "touch '$probe' && rm -f '$probe'" 2>/dev/null; then
    ok "$svc_user can write $DATA_DIR"
  else
    err "$svc_user CANNOT write $DATA_DIR - nothing changed in the panel is saved"
    echo "    Fix it with: chown -R $svc_user $DATA_DIR"
  fi

  # a firewall that does not allow the panel port is the classic "it worked
  # yesterday" cause, especially right after the port has been changed
  local fw
  fw="$(firewall_kind)"
  printf "  %-22s %s\n" "Firewall" "$fw"
  case "$fw" in
    ufw)
      if ufw status 2>/dev/null | grep -qE "(^|[[:space:]])${port}(/tcp)?[[:space:]]+ALLOW"; then
        ok "ufw allows port $port"
      else
        err "ufw does NOT allow port $port - the panel is unreachable from outside"
        echo "    Fix it with: nexv firewall   (option 4), or: ufw allow ${port}/tcp"
      fi
      ;;
    firewalld)
      if firewall-cmd --list-ports 2>/dev/null | grep -q "${port}/tcp"; then
        ok "firewalld allows port $port"
      else
        err "firewalld does NOT allow port $port"
        echo "    Fix it with: nexv firewall   (option 4)"
      fi
      ;;
    *) ok "No firewall is filtering the panel port" ;;
  esac

  # a panel parked on a high port is the classic "it runs but will not open":
  # carriers, office networks and captive portals filter everything but 80/443.
  # Those two belong to the inbounds, so the port-80 redirect is the way out.
  if [[ $port != 443 && $port != 80 ]]; then
    warn "Port $port can be filtered by mobile carriers and office networks"
    echo "    To use another port:  nexv fix <port>"
  fi

  # the panel squatting on a port an inbound wants is worth saying out loud
  if [[ $port == 443 || $port == 80 ]]; then
    warn "The panel holds port $port, which an inbound usually wants"
    echo "    Move it with: nexv fix <port>"
  fi

  # two panels managing one Xray is a fight neither wins
  if [[ -f /usr/local/bin/x-ui || -d /usr/local/x-ui || -d /etc/x-ui ]]; then
    warn "3x-ui is also installed on this server"
    echo "    Both panels write /usr/local/etc/xray/config.json and restart the"
    echo "    xray service, so each one undoes the other's configuration."
    echo "    Keep one of them, or point them at different files."
  fi

  if [[ $secure == yes && -f $cert ]]; then
    local expiry
    expiry="$(openssl x509 -enddate -noout -in "$cert" 2>/dev/null | cut -d= -f2)"
    [[ -n $expiry ]] && printf "  %-22s %s\n" "Certificate expires" "$expiry"
    openssl x509 -checkend 604800 -noout -in "$cert" >/dev/null 2>&1 \
      || warn "The certificate expires within a week; run: nexv cert <domain>"
  fi

  # the real test: does the panel answer on its own URL?
  local url="${scheme}://127.0.0.1:${port}${webpath}/login"
  local code
  code="$(curl -sk -o /dev/null -m 10 -w '%{http_code}' "$url" 2>/dev/null)"
  code="${code:-000}"
  if [[ $code == 200 ]]; then
    ok "The panel answers on $scheme://$host:$port${webpath}/"
  else
    err "The panel did not answer on $url (HTTP $code)"
    echo
    echo "  Last 20 panel log lines:"
    journalctl -u "$SERVICE" -n 20 --no-pager 2>/dev/null | sed 's/^/    /'
  fi

  # the port-80 redirect is opt-in, so only check it when it is switched on
  if [[ $secure == yes && $port != 80 ]] && DATA_DIR="$DATA_DIR" node -e '
    try {
      const db = require(process.env.DATA_DIR + "/db.json");
      process.exit(db.settings && db.settings.httpRedirect === true ? 0 : 1);
    } catch (e) { process.exit(1); }
  ' 2>/dev/null; then
    if DATA_DIR="$DATA_DIR" node -e '
      try {
        const db = require(process.env.DATA_DIR + "/db.json");
        process.exit((db.inbounds || []).some((i) => i.enable !== false && Number(i.port) === 80) ? 0 : 1);
      } catch (e) { process.exit(1); }
    ' 2>/dev/null; then
      ok "Port 80 is used by an inbound, so the redirect stays off"
    else
      code="$(curl -s -o /dev/null -m 10 -w '%{http_code}' "http://127.0.0.1/" 2>/dev/null)"
      code="${code:-000}"
      [[ $code == 301 ]] && ok "Port 80 redirects to the panel" \
        || warn "Port 80 redirect is enabled but not answering (HTTP $code)"
    fi
  fi
  echo
}

# Move the panel to a port you name, then prove it answers there.
#
# It changes nothing you did not ask for: with no port it only reports. The
# panel never picks a port for you, and never takes one from your inbounds.
act_fix() {
  need_root
  local wanted="${1:-}"
  echo
  echo "${BOLD}Panel port${RESET}"
  echo

  local port owner
  port="$(panel_port)"
  printf "  %-24s %s\n" "Current panel port" "$port"

  local cert key secure
  cert="$(DATA_DIR=$DATA_DIR node -e '
    const db = require(process.env.DATA_DIR + "/db.json");
    const s = db.settings || {};
    process.stdout.write(s.panelCertFile || s.certFile || "");
  ' 2>/dev/null)"
  key="$(DATA_DIR=$DATA_DIR node -e '
    const db = require(process.env.DATA_DIR + "/db.json");
    const s = db.settings || {};
    process.stdout.write(s.panelKeyFile || s.keyFile || "");
  ' 2>/dev/null)"
  secure=no
  [[ -n $cert && -n $key && -f $cert && -f $key ]] && secure=yes
  printf "  %-24s %s\n" "HTTPS" "$secure"

  if [[ -z $wanted ]]; then
    echo
    if [[ $port == 80 || $port == 443 ]]; then
      warn "The panel holds port $port, which an inbound usually wants."
    fi
    echo "  To change it:  nexv fix <port>"
    echo
    return 0
  fi

  [[ $wanted =~ ^[0-9]+$ ]] && (( wanted >= 1 && wanted <= 65535 )) \
    || { err "Give a port number between 1 and 65535"; return 1; }

  if [[ $wanted != "$port" ]]; then
    if is_port_in_use "$wanted"; then
      owner="$(port_owner "$wanted")"
      err "Port $wanted is already taken by: ${owner:-another process}"
      return 1
    fi
    info_port_move "$port" "$wanted" || return 1
    port="$wanted"
  else
    ok "The panel is already on port $port"
  fi

  allow_port "$port"

  systemctl restart "$SERVICE"
  sleep 3
  if ! systemctl is-active --quiet "$SERVICE"; then
    err "The panel did not come back up."
    journalctl -u "$SERVICE" -n 20 --no-pager | sed 's/^/    /'
    return 1
  fi

  local webpath host url code scheme
  webpath="$(DATA_DIR=$DATA_DIR node -e '
    const db = require(process.env.DATA_DIR + "/db.json");
    process.stdout.write((db.settings && db.settings.webBasePath) || "");
  ' 2>/dev/null)"
  host="$(DATA_DIR=$DATA_DIR node -e '
    const db = require(process.env.DATA_DIR + "/db.json");
    const s = db.settings || {};
    process.stdout.write(s.domain || s.serverIP || "127.0.0.1");
  ' 2>/dev/null)"
  scheme=http
  [[ $secure == yes ]] && scheme=https

  url="${scheme}://127.0.0.1:${port}${webpath}/login"
  code="$(curl -sk -o /dev/null -m 10 -w '%{http_code}' "$url" 2>/dev/null)"
  code="${code:-000}"
  if [[ $code == 200 ]]; then
    ok "The panel answers on port $port"
  else
    err "The panel is not answering on $port (HTTP $code)"
    journalctl -u "$SERVICE" -n 20 --no-pager | sed 's/^/    /'
    return 1
  fi

  echo
  echo "${GREEN}${BOLD}  Open this:${RESET}"
  echo "${BOLD}  ${scheme}://${host}:${port}${webpath}/${RESET}"
  echo
}

# Write a new panel port, reporting what changed.
info_port_move() {
  local from="$1" to="$2"
  PORT="$to" DATA_DIR="$DATA_DIR" node -e '
    const fs = require("fs"), path = require("path");
    const file = path.join(process.env.DATA_DIR, "db.json");
    const db = JSON.parse(fs.readFileSync(file, "utf8"));
    db.settings = db.settings || {};
    db.settings.panelPort = Number(process.env.PORT);
    fs.writeFileSync(file, JSON.stringify(db, null, 2), { mode: 0o600 });
  ' || { err "Could not write the new port"; return 1; }
  ok "Panel port moved from $from to $to"
}

# Why xray will not start, and how to get it back.
#
# `systemctl start xray` only ever says "failed"; the reason is in the journal
# or in a config the panel wrote that binds a port something else already owns.
act_xray_fix() {
  need_root
  local cfg="/usr/local/etc/xray/config.json"
  local bin="/usr/local/bin/xray"
  echo
  echo "${BOLD}Xray recovery${RESET}"
  echo

  [[ -x $bin ]] || { err "xray is not installed at $bin"; return 1; }
  [[ -f $cfg ]] || { err "no config at $cfg"; echo "  Rebuild it from the panel: nexv restart"; return 1; }

  if systemctl is-active --quiet xray; then
    ok "Xray is already running"
    return 0
  fi

  local user
  user="$(xray_user)"
  printf "  %-24s %s\n" "Xray runs as" "$user"
  echo

  # 1. does the config parse AS THE SERVICE USER? Testing as root hides the
  #    most common failure of all: a certificate root can read and nobody cannot.
  local test_out
  if [[ $user != root ]] && command -v runuser >/dev/null 2>&1; then
    test_out="$(runuser -u "$user" -- "$bin" run -test -config "$cfg" 2>&1)" && test_ok=1 || test_ok=0
  else
    test_out="$("$bin" run -test -config "$cfg" 2>&1)" && test_ok=1 || test_ok=0
  fi

  if [[ $test_ok == 1 ]]; then
    ok "The config loads as $user"
  else
    err "The config does not load as $user:"
    echo "$test_out" | tail -4 | sed 's/^/    /'
    echo
    if grep -qi "permission denied" <<<"$test_out"; then
      warn "That is a file permission problem, not a broken config."
      echo "  Xray runs as '$user' and cannot read the certificate."
      echo
      if confirm "  Fix the certificate permissions now?"; then
        act_cert_fix
        return $?
      fi
      echo "  The panel repairs this on its own within a minute."
    else
      echo "  Rewrite the config from the panel's own data:  nexv restart"
    fi
    return 1
  fi

  # 2. the usual runtime killer: a port somebody else already owns
  local busy=0 port owner
  while read -r port; do
    [[ $port =~ ^[0-9]+$ ]] || continue
    if is_port_in_use "$port"; then
      owner="$(port_owner "$port")"
      if [[ -n $owner && $owner != *xray* ]]; then
        err "Inbound port $port is held by: $owner"
        busy=1
      fi
    fi
  done < <(node -e '
    try {
      const cfg = require("/usr/local/etc/xray/config.json");
      for (const i of cfg.inbounds || []) if (i.port) console.log(i.port);
    } catch (e) {}
  ' 2>/dev/null)

  # an inbound on the panel's own port is a collision the panel used to allow
  local ppanel
  ppanel="$(panel_port)"
  if node -e '
    try {
      const cfg = require("/usr/local/etc/xray/config.json");
      const hit = (cfg.inbounds || []).find((i) => Number(i.port) === Number(process.argv[1]));
      process.exit(hit ? 0 : 1);
    } catch (e) { process.exit(1); }
  ' "$ppanel" 2>/dev/null; then
    err "An inbound uses port $ppanel, which is the panel's own port"
    echo "    Change or delete that inbound in the panel, then: systemctl restart xray"
    busy=1
  fi

  if [[ $busy == 1 ]]; then
    echo
    echo "  Xray cannot bind a port another program is using."
    echo "  Change or disable that inbound in the panel, then: systemctl restart xray"
    return 1
  fi

  # 3. nothing obvious - start it and report what the journal says
  systemctl start xray 2>/dev/null
  sleep 2
  if systemctl is-active --quiet xray; then
    ok "Xray started"
    return 0
  fi

  err "Xray still refuses to start. Last log lines:"
  journalctl -u xray -n 25 --no-pager | sed 's/^/    /'
  return 1
}

# The user systemd starts xray as. The official XTLS unit uses `nobody`.
xray_user() {
  local u
  u="$(systemctl show xray -p User --value 2>/dev/null)"
  echo "${u:-root}"
}

# Copy the certificate somewhere xray can actually read it.
#
# Let's Encrypt keeps /etc/letsencrypt/{live,archive} root-only, and xray runs
# as `nobody`, so pointing an inbound straight at fullchain.pem makes the
# service die with "permission denied" - while `xray -test` as root passes.
# Keep a readable copy instead of loosening the letsencrypt tree.
CERT_STORE="/usr/local/etc/xray/certs"

sync_cert_copy() {
  local src_cert="$1" src_key="$2" name="$3"
  local dir="$CERT_STORE/$name"
  local user group
  user="$(xray_user)"
  group="$(id -gn "$user" 2>/dev/null || echo root)"

  mkdir -p "$dir"
  # -L so a symlink into archive/ becomes a real file
  cp -L "$src_cert" "$dir/fullchain.pem" || return 1
  cp -L "$src_key" "$dir/privkey.pem" || return 1
  chown -R "root:$group" "$dir" 2>/dev/null || true
  chmod 755 "$CERT_STORE" "$dir"
  chmod 644 "$dir/fullchain.pem"
  chmod 640 "$dir/privkey.pem"
  echo "$dir"
}

act_cert_fix() {
  need_root
  echo
  echo "${BOLD}Certificate permissions${RESET}"
  echo

  local user
  user="$(xray_user)"
  printf "  %-24s %s\n" "Xray runs as" "$user"

  local cert key
  cert="$(DATA_DIR=$DATA_DIR node -e '
    const db = require(process.env.DATA_DIR + "/db.json");
    process.stdout.write((db.settings && db.settings.certFile) || "");
  ' 2>/dev/null)"
  key="$(DATA_DIR=$DATA_DIR node -e '
    const db = require(process.env.DATA_DIR + "/db.json");
    process.stdout.write((db.settings && db.settings.keyFile) || "");
  ' 2>/dev/null)"

  [[ -n $cert && -n $key ]] || { err "No certificate configured. Run: nexv cert <domain>"; return 1; }
  [[ -f $cert && -f $key ]] || { err "Configured certificate is missing: $cert"; return 1; }
  printf "  %-24s %s\n" "Certificate" "$cert"

  if [[ $user == root ]]; then
    ok "Xray runs as root and can already read it"
  elif runuser -u "$user" -- test -r "$cert" 2>/dev/null && runuser -u "$user" -- test -r "$key" 2>/dev/null; then
    ok "$user can already read the certificate"
  else
    warn "$user cannot read the certificate - this is why Xray will not start"
  fi

  local name dir
  name="$(basename "$(dirname "$cert")")"
  [[ -n $name && $name != "." ]] || name="panel"
  dir="$(sync_cert_copy "$cert" "$key" "$name")" || { err "Could not copy the certificate"; return 1; }
  ok "Readable copy written to $dir"

  if [[ $user != root ]] && ! runuser -u "$user" -- test -r "$dir/privkey.pem" 2>/dev/null; then
    err "$user still cannot read $dir/privkey.pem"
    # the file modes are right, so the usual cause is a parent directory that
    # the service user is not allowed to walk into
    local walk="$dir"
    while [[ $walk != / ]]; do
      if ! runuser -u "$user" -- test -x "$walk" 2>/dev/null; then
        echo "    Blocked at: $walk ($(stat -c '%a %U:%G' "$walk"))"
        echo "    Make it traversable:  chmod o+x $walk"
        break
      fi
      walk="$(dirname "$walk")"
    done
    return 1
  fi

  # point the Xray inbounds at the copy; the panel keeps reading the original
  CERT="$dir/fullchain.pem" KEY="$dir/privkey.pem" SRC_CERT="$cert" SRC_KEY="$key" DATA_DIR="$DATA_DIR" node -e '
    const fs = require("fs"), path = require("path");
    const file = path.join(process.env.DATA_DIR, "db.json");
    const db = JSON.parse(fs.readFileSync(file, "utf8"));
    db.settings = db.settings || {};
    db.settings.certFile = process.env.CERT;
    db.settings.keyFile = process.env.KEY;
    // the panel runs as root, so it can keep using the original paths
    db.settings.panelCertFile = db.settings.panelCertFile || process.env.SRC_CERT;
    db.settings.panelKeyFile = db.settings.panelKeyFile || process.env.SRC_KEY;
    for (const inb of db.inbounds || []) {
      if (inb.certFile) inb.certFile = process.env.CERT;
      if (inb.keyFile) inb.keyFile = process.env.KEY;
    }
    fs.writeFileSync(file, JSON.stringify(db, null, 2), { mode: 0o600 });
  ' || { err "Could not update the panel settings"; return 1; }
  ok "Inbounds now point at the readable copy"

  install_cert_sync_hook "$cert" "$key" "$name"

  systemctl restart "$SERVICE"
  sleep 3
  systemctl restart xray 2>/dev/null
  sleep 2
  if systemctl is-active --quiet xray; then
    ok "Xray is running"
  else
    err "Xray still will not start. Last log lines:"
    journalctl -u xray -n 20 --no-pager | sed "s/^/    /"
    return 1
  fi
}

# Renewal replaces the originals, so the copy has to be refreshed too.
install_cert_sync_hook() {
  local src_cert="$1" src_key="$2" name="$3"
  cat > /usr/local/bin/nexv-cert-sync <<EOF
#!/usr/bin/env bash
# Refresh the Xray-readable copy of the certificate after renewal.
set -e
user="\$(systemctl show xray -p User --value 2>/dev/null)"
user="\${user:-root}"
group="\$(id -gn "\$user" 2>/dev/null || echo root)"
dir="$CERT_STORE/$name"
mkdir -p "\$dir"
cp -L "$src_cert" "\$dir/fullchain.pem"
cp -L "$src_key" "\$dir/privkey.pem"
chown -R "root:\$group" "\$dir" || true
chmod 755 "$CERT_STORE" "\$dir"
chmod 644 "\$dir/fullchain.pem"
chmod 640 "\$dir/privkey.pem"
systemctl restart xray nexv || true
EOF
  chmod 755 /usr/local/bin/nexv-cert-sync
  cat > /etc/cron.d/nexv-cert-renew <<'EOF'
0 3 * * * root certbot renew --quiet --deploy-hook /usr/local/bin/nexv-cert-sync
EOF
  ok "Renewal will refresh the copy automatically"
}

act_uninstall() {
  need_root
  confirm "Remove the panel from this server?" || { echo "Cancelled"; return 0; }
  systemctl disable --now "$SERVICE" 2>/dev/null || true
  rm -f /etc/systemd/system/${SERVICE}.service /etc/cron.d/nexv-cert-renew
  systemctl daemon-reload
  rm -rf "$INSTALL_DIR"
  if confirm "Also delete all data (admins, inbounds, clients)?"; then
    rm -rf /etc/nexv
  fi
  rm -f /usr/local/bin/nexv
  ok "Panel removed"
  exit 0
}

# -------------------------------------------------------------------- menu --

state_of() {
  systemctl is-active --quiet "$1" 2>/dev/null && echo "${GREEN}Running${RESET}" || echo "${RED}Stopped${RESET}"
}

enabled_of() {
  systemctl is-enabled --quiet "$1" 2>/dev/null && echo "${GREEN}Yes${RESET}" || echo "${RED}No${RESET}"
}

# The box is drawn at a fixed inner width of 42 columns. Colour codes sit
# outside the printf field widths so they do not count towards the padding.
menu_top()  { printf "  ${CYAN}┌──────────────────────────────────────────┐${RESET}\\n"; }
menu_rule() { printf "  ${CYAN}├──────────────────────────────────────────┤${RESET}\\n"; }
menu_end()  { printf "  ${CYAN}└──────────────────────────────────────────┘${RESET}\\n"; }
menu_head() { printf "  ${CYAN}│${RESET}  ${BOLD}%-40s${RESET}${CYAN}│${RESET}\\n" "$1"; }
menu_row()  { printf "  ${CYAN}│${RESET}  ${CYAN}%2s${RESET}. %-36s${CYAN}│${RESET}\\n" "$1" "$2"; }

show_menu() {
  clear 2>/dev/null || true
  echo
  menu_top
  menu_head "NexV Panel Management Script"
  menu_row 0 "Exit"
  menu_rule
  menu_row 1 "Update panel"
  menu_row 2 "Uninstall"
  menu_rule
  menu_row 3 "Reset admin password"
  menu_row 4 "Reset admin username"
  menu_row 5 "Reset web base path"
  menu_row 6 "Change panel port"
  menu_row 7 "Show current settings"
  menu_row 8 "Show panel URL"
  menu_rule
  menu_row 9 "Start panel"
  menu_row 10 "Stop panel"
  menu_row 11 "Restart panel"
  menu_row 12 "Restart Xray"
  menu_row 13 "Check status"
  menu_row 14 "Panel logs"
  menu_row 15 "Xray logs"
  menu_rule
  menu_row 16 "Enable autostart"
  menu_row 17 "Disable autostart"
  menu_rule
  menu_row 18 "SSL certificate (Let's Encrypt)"
  menu_row 19 "Open firewall ports"
  menu_row 20 "Backup configuration"
  menu_row 21 "Restore configuration"
  menu_rule
  menu_row 22 "Enable BBR"
  menu_row 23 "Update geo files"
  menu_rule
  menu_row 24 "Diagnose problems"
  menu_row 25 "Change the panel port"
  menu_end
  echo
  printf "  Panel state        : %s\n" "$(state_of "$SERVICE")"
  printf "  Start automatically: %s\n" "$(enabled_of "$SERVICE")"
  printf "  Xray state         : %s\n" "$(state_of xray)"
  echo
}

run_menu() {
  while true; do
    show_menu
    local choice domain file port name repeat
    read -rp "  Please enter your selection [0-25]: " choice
    echo
    case "$choice" in
      0) exit 0 ;;
      1) act_update; pause ;;
      2) act_uninstall; pause ;;
      3) echo "  Leave the password empty to have one generated for you."
         read -rsp "  New admin password: " name; echo
         if [[ -n $name ]]; then
           read -rsp "  Repeat the password: " repeat; echo
           if [[ $name != "$repeat" ]]; then
             err "The passwords do not match - nothing was changed"
             pause; continue
           fi
         fi
         act_reset_password "$name"; pause ;;
      4) read -rp "New admin username: " name; act_reset_username "$name"; pause ;;
      5) echo "Enter a path, or 'random' for a generated one, or 'none' to disable."
         read -rp "New web base path: " name; act_url "$name"; pause ;;
      6) read -rp "New panel port: " port; act_port "$port"; pause ;;
      7) act_settings; pause ;;
      8) act_url; pause ;;
      9) act_service start; pause ;;
      10) act_service stop; pause ;;
      11) act_service restart; pause ;;
      12) need_root; systemctl restart xray && ok "Xray restarted" || err "Xray restart failed"; pause ;;
      13) act_status; pause ;;
      14) echo "${YELLOW}Press Ctrl+C to stop following the log.${RESET}"; act_logs 100 ;;
      15) echo "${YELLOW}Press Ctrl+C to stop following the log.${RESET}"; act_xray_logs 100 ;;
      16) need_root; systemctl enable "$SERVICE" >/dev/null 2>&1 && ok "Autostart enabled"; pause ;;
      17) need_root; systemctl disable "$SERVICE" >/dev/null 2>&1 && ok "Autostart disabled"; pause ;;
      18) read -rp "Domain: " domain; act_cert "$domain"; pause ;;
      19) act_firewall; pause ;;
      20) act_backup; pause ;;
      21) read -rp "Path to the backup file: " file; act_restore "$file"; pause ;;
      22) act_bbr; pause ;;
      23) act_geo; pause ;;
      24) act_doctor; pause ;;
      25) read -rp "  New panel port (empty = just report): " port
          act_fix "$port"; pause ;;
      *) err "Please choose a number between 0 and 27"; pause ;;
    esac
  done
}

usage() {
  cat <<HELP
${BOLD}nexv${RESET} - NexV Panel management

  nexv                          open the management menu
  nexv status                   panel and Xray service status
  nexv start|stop|restart       control the panel service
  nexv logs [n]                 follow the panel log
  nexv xray-logs [n]            follow the Xray log
  nexv update                   update from the repository
  nexv backup [file]            write a backup
  nexv restore <file>           restore from a backup
  nexv url                      print the full panel URL
  nexv path <p|random|none>     change the secret web path
  nexv port <number>            change the panel port
  nexv settings                 print the current settings
  nexv cert <domain>            request a Let's Encrypt certificate
  nexv reset-password [pw]      set the admin password (generated when omitted)
  nexv reset-username <name>    change the admin username
  nexv firewall                 open the panel ports
  nexv bbr                      enable BBR congestion control
  nexv geo                      update geoip.dat and geosite.dat
  nexv doctor                   diagnose why the panel is not answering
  nexv fix [port]               change the panel port and verify it answers
  nexv uninstall                remove the panel
HELP
}

case "${1:-menu}" in
  menu)            run_menu ;;
  status)          act_status ;;
  start|stop|restart) act_service "$1" ;;
  logs)            act_logs "${2:-100}" ;;
  xray-logs)       act_xray_logs "${2:-100}" ;;
  update)          act_update ;;
  backup)          act_backup "${2:-}" ;;
  restore)         act_restore "${2:-}" ;;
  url)             act_url ;;
  path)            act_url "${2:-}" ;;
  port)            act_port "${2:-}" ;;
  settings)        act_settings ;;
  cert)            act_cert "${2:-}" ;;
  reset-password)  act_reset_password "${2:-}" ;;
  reset-username)  act_reset_username "${2:-}" ;;
  firewall)        act_firewall ;;
  bbr)             act_bbr ;;
  geo)             act_geo ;;
  doctor)          act_doctor ;;
  fix)             act_fix "${2:-}" ;;
  xray-fix)        act_xray_fix ;;
  cert-fix)        act_cert_fix ;;
  uninstall)       act_uninstall ;;
  help|-h|--help)  usage ;;
  *)               err "Unknown command: $1"; echo; usage; exit 1 ;;
esac
